# ---------------------------------------------------------------------------
# VIET RICE — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Database (required for persistence) -----------------------------------
# PostgreSQL connection string. Neon/Supabase/Vercel Postgres all work.
# Without it the app still runs: the public site renders from the seed content
# modules and the reservation API validates but does not store bookings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vietrice?schema=public"
# If the database is shared with another project, give this app its own schema
# (e.g. `&schema=vietrice`) so `prisma migrate` can never reset the other one.
# Neon/Supabase poolers need a direct URL for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/vietrice?schema=public"

# --- Auth ------------------------------------------------------------------
# Secret used to sign admin session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin, used for cookies, callbacks and absolute URLs.
NEXTAUTH_URL="http://localhost:3000"

# --- Seed admin ------------------------------------------------------------
# Used ONLY by `npm run db:seed` to create the first SUPER_ADMIN.
# Change the password immediately after the first login.
SEED_ADMIN_EMAIL="admin@vietrice-restaurant.de"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Viet Rice Admin"

# --- AI Chef Assistant -----------------------------------------------------
# Leave AI_PROVIDER unset (or empty) to run the grounded rule-based demo mode.
# The UI labels answers as "demo mode" when no provider is configured.
AI_PROVIDER=""
OPENAI_API_KEY=""

# --- Email (optional) ------------------------------------------------------
# Used for booking acknowledgements and newsletter double opt-in.
RESEND_API_KEY=""
EMAIL_FROM="Viet Rice <noreply@vietrice-restaurant.de>"

# --- Media (optional) ------------------------------------------------------
# Only needed if you upload images through Admin instead of shipping them in
# /public/images. Never expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Vercel Blob — required to upload dish videos from Admin > Speisekarte.
# Create it in the Vercel dashboard: Storage > Blob > connect to this project.
# Vercel injects it into deployments automatically; copy it into .env to test
# uploads locally. Without it the upload button returns an error rather than
# silently doing nothing.
BLOB_READ_WRITE_TOKEN=""

# --- Public site config ----------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google Maps (optional) ------------------------------------------------
# The footer map uses Google's keyless embed, so no browser key is required.
# A server-side key is only needed if you add Geocoding/Places later — keep it
# server-only, never prefix it with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=""
